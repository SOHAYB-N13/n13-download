{
  "manifest_version": 3,
  "name": "Terminal Download Manager",
  "version": "2.0.0",
  "description": "Send downloads to Terminal Download Manager via authenticated Live Server",
  "permissions": [
    "contextMenus",
    "notifications",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:6868/*",
    "http://localhost:6868/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TDM",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "download-current-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Download current page with TDM"
    }
  }
}