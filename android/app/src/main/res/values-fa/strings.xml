<?xml version="1.0" encoding="utf-8"?>
<!--
  Persian (Farsi) translation of values/strings.xml.

  Terminology follows the everyday Iranian software vocabulary rather than
  literal translation: "دانلود" (download), "صف" (queue), "مقصد" (destination),
  "پهنای باند" (bandwidth), "چکسام" (checksum).

  These strings are UI prose and read right-to-left.  URLs, file paths, file
  names and byte counts are never translated here — they are pinned LTR in the
  UI so they keep their own reading order.
-->
